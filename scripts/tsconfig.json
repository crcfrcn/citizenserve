{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts", "vitest/globals"],
    "lib": ["ES2022", "WebWorker"],
    "noEmit": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["../src/**/*.ts", "../test/**/*.ts", "ci/vitest.config.ts", "release/release_manifest.test.ts"]
}
